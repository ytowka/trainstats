    "views": [
      {
        "viewName": "ExerciseCountView",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS select s.exerciseId as exerciseId, count(*) as inWorkouts, count(distinct(w.id)) as totalSets from WorkoutEntity as w\n    inner join ExerciseSetEntity as s on w.id = s.workoutId\n    group by s.exerciseId"
      },
      {
        "viewName": "ExerciseLastUsedView",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT s.exerciseId as exerciseId, MAX(w.dateTime) as lastUsed \n    FROM WorkoutEntity w\n    INNER JOIN ExerciseSetEntity s ON w.id = s.workoutId\n    GROUP BY s.exerciseId"
      }
